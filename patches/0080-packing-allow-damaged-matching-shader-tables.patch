From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bf39l <boliu1234@gmail.com>
Date: Mon, 23 Nov 2026 11:40:00 +1300
Subject: [PATCH] packing: honor allow-damaged with matching shader tables

Upstream-Status: fork-only
Reason: an explicit damaged-package build should proceed when all registered shader tables match
Issue: local Xenoblade Chronicles 3 build (010074F013262000)

Keep unreadable-file warnings and all registered table comparisons. Normal
builds still reject unreadable files; the override still rejects shader
mismatches and is separate in the split cache key.

Checked 88 incremental build tests, six documentation tests, Python lint,
and all 27,055 extracted shader keys against the registered profile.
---
diff --git a/dm/tools/tests/test_nsp_incremental.py b/dm/tools/tests/test_nsp_incremental.py
index 419ca884ea59e03b9577b1b1e09683a3cb729268..eb2577e5a10e2ca4be0b3b9cc207d38813b43cf9 100644
--- a/dm/tools/tests/test_nsp_incremental.py
+++ b/dm/tools/tests/test_nsp_incremental.py
@@ -891,6 +891,20 @@ class SplitShaders(Base):
         for n in self.NAMES[:3]: (self.src / n).write_text(self.table(n))
         with self.assertRaisesRegex(nsp.BuildError, r'^2 file\(s\) could not be read'): self.go(game.Game(self.src), own=False)
 
+    def test_allow_damaged_registered_split_still_requires_matching_tables(self):
+        self.log = '[RED] 1 file(s) could not be read (first: archive: bad compressed texture)\nshaders: 3 (3 vertex)\n'
+        for n in self.NAMES: (self.src / n).write_text(self.table(n))
+        g = game.Game(self.src)
+        with mock.patch.object(nsp, 'ALLOW_DAMAGED', True):
+            self.go(g, own=False)
+            self.go(g, own=False)
+            self.assertEqual(self.splits, 1)
+            self.rows = 'missing shader'; (self.ex / 'RomFS/b.bin').write_bytes(b'changed')
+            with self.assertRaisesRegex(nsp.BuildError, 'differ from game profile'):
+                self.go(g, own=False)
+        with self.assertRaisesRegex(nsp.BuildError, r'^1 file\(s\) could not be read'):
+            self.go(g, own=False)
+
     def test_mode_is_in_the_key(self):   # the same files split as an own profile, then checked against them as a registered one
         g = self.own(); self.go(g)
         self.assertEqual(self.go(g, own=False), nsp.package_key(self.pkg)); self.assertEqual(self.splits, 2)
diff --git a/scripts/build_ipa_from_nsp.py b/scripts/build_ipa_from_nsp.py
index d91c1b1ce2b38221a3342a0ddf7483398b57dd58..ff3a43493ffc764272c6f0e4422753c7ac2ee54a 100755
--- a/scripts/build_ipa_from_nsp.py
+++ b/scripts/build_ipa_from_nsp.py
@@ -2763,7 +2763,7 @@ def split_shaders(py, repo, roms, mains, pkg, env, logs, g, provisional=False, o
         text = (logs / 'shader_split.log').read_text(errors='replace')
     m = re.search(r'shaders: (\d+) \(', text)
     bad = re.search(r'^\[RED\] (\d+) file\(s\) could not be read.*$', text, re.M)   # the split leaves out a file no reader reads (its own red line per file in the log) and goes on
-    if bad and not provisional:   # the profile's tables were split from every file: one that does not read now is a reader change
+    if bad and not provisional and not ALLOW_DAMAGED:   # --allow-damaged still has to pass every registered shader-table comparison below
         raise BuildError(f'{bad.group(0).removeprefix("[RED] ")}; the profile\'s tables hold every file\'s shaders (each file in {logs / "shader_split.log"})')
     if bad: say(f'{bad.group(0)}; the IPA goes without them (each file in {logs / "shader_split.log"})')
     if m and m.group(1) == '0':   # dmsh_build.py would make no library, and the iOS shader step stop with no word of why
